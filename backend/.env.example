# Server
PORT=4000
NODE_ENV=development

# Postgres — use EITHER the discrete vars below (recommended, especially on
# Windows or if your password has special characters) OR DATABASE_URL, not both.
# Set PGSSLMODE=disable only for a local Postgres with no SSL configured —
# managed providers (Supabase, Render Postgres, etc.) require SSL, which is
# on by default here.

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_actual_password_here
PGDATABASE=zemen_lottery
# PGSSLMODE=disable

# DATABASE_URL=postgresql://postgres:password@localhost:5432/zemen_lottery
# ^ If you use this instead, any @ : / # ? in the password MUST be percent-encoded
#   (e.g. p@ss becomes p%40ss) or the connection string parses incorrectly.

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — set this to your deployed frontend's exact origin in production
# (e.g. https://zemen-lottery.vercel.app). Left unset, all origins are
# allowed, which is fine for local dev only.
FRONTEND_URL=

# Cloudinary — used for deposit screenshot storage. Screenshots are
# uploaded as "authenticated" assets, never publicly reachable by URL —
# see src/config/cloudinary.js. Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sample receiving accounts shown to users during deposit. Replace with
# your real accounts before going live.
CBE_ACCOUNT_NAME=Zemen Lottery PLC
CBE_ACCOUNT_NUMBER=1000123456789
TELEBIRR_ACCOUNT_NAME=Zemen Lottery PLC
TELEBIRR_PHONE_NUMBER=0912345678

# Withdrawal business rules
WITHDRAWAL_FEE_PERCENT=10
MIN_WITHDRAWAL_AMOUNT=100

# Referral program
REFERRAL_REWARD_ETB=10
REFERRAL_REWARD_POINTS=5
REFERRAL_MIN_DEPOSIT=100

# Bank SMS auto-verification — shared secret the SMS-bridge device (or
# admin's manual-paste form) must send as the X-Bank-Sms-Secret header.
# Generate a long random value; treat it like a password.
BANK_SMS_SECRET=
